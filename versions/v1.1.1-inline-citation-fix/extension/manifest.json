{
  "manifest_version": 3,
  "name": "AI Conversation Recorder",
  "version": "1.1.0",
  "description": "自动捕获网页 AI 对话并保存为本地 Markdown 文件",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI 对话记录"
  }
}
